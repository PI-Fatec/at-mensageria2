{
  "name": "at-mensageria2",
  "version": "0.0.1",
  "description": "Trabalho de Mensageria - Versão JS",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "eslint \"{src,test}/**/*.js\" --fix",
    "test": "jest --passWithNoTests",
    "start:prod": "node src/server.js"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.0",
    "@prisma/client": "^6.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.6.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.js$",
    "collectCoverageFrom": [
      "**/*.(j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}